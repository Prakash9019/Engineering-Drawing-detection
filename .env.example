# Local runtime configuration. Keep the real .env file out of Git.
GEMINI_KEY=

# Optional shared demo API key. Set CDCI_AUTH_REQUIRED=true to fail closed.
CDCI_API_KEY=
CDCI_AUTH_REQUIRED=false

CDCI_RUNTIME_DIR=runtime
CDCI_MAX_UPLOAD_BYTES=52428800
CDCI_WORKER_POLL_SECONDS=2
CDCI_WORKER_LEASE_SECONDS=900
CDCI_JOB_MAX_ATTEMPTS=2
CDCI_CORS_ORIGINS=http://localhost:3000

# Task-specific model routing overrides.
CDCI_MODEL_CLASSIFY=gemini-2.5-flash-lite
CDCI_MODEL_TITLE=gemini-2.5-flash
CDCI_MODEL_CLOUD=gemini-3.1-pro-preview
CDCI_MODEL_NOTES=gemini-2.5-flash
CDCI_MODEL_SOW=gemini-2.5-flash
CDCI_MODEL_EXTRACTION=gemini-3.1-pro-preview
CDCI_MODEL_TABLE=gemini-2.5-flash
CDCI_MODEL_TABLE_FALLBACK=gemini-2.5-pro
